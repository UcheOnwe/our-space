# Copy this file to .env and adjust as needed for local development.

DJANGO_SECRET_KEY=change-me-in-real-environments
DJANGO_DEBUG=True
# Comma-separated. Add a LAN IP here too (e.g. 10.0.0.154) to test the app
# from a phone on the same Wi-Fi — find yours with `ipconfig` (Windows) or
# `ifconfig`/`ip addr` (macOS/Linux).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=our_space
POSTGRES_USER=our_space
POSTGRES_PASSWORD=our_space
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Origin(s) of the local React dev server, for session/CSRF trust during
# development. Comma-separated — list every origin you'll actually load the
# frontend from at once, e.g. desktop + a phone on the same LAN:
# FRONTEND_ORIGINS=http://localhost:5173,http://10.0.0.154:5173
FRONTEND_ORIGINS=http://localhost:5173
