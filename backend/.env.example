# Copy this file to .env and adjust as needed for local development.

DJANGO_SECRET_KEY=change-me-in-real-environments
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=our_space
POSTGRES_USER=our_space
POSTGRES_PASSWORD=our_space
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Origin of the local React dev server, for CORS/CSRF trust during development.
FRONTEND_ORIGIN=http://localhost:5173
